# OpenAI — leave empty to use the local composer (dry-run still works)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SMTP — required only for live sends (omit --dry-run)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JR Intelligence <hello@jrintelligence.com>"

# Campaign
LEADS_CSV=./leads.csv
CAMPAIGN_STATE_PATH=./campaign_state.json
TEST_EMAILS_DIR=./dist/test-emails
OPTOUT_EMAIL=optout@jrintelligence.com
AGENCY_URL=https://jrintelligence.com

# Jitter between live sends (minutes). Dry-run ignores this.
JITTER_MIN_MINUTES=3
JITTER_MAX_MINUTES=9
