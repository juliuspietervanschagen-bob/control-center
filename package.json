{
  "name": "jr-intelligence-outreach",
  "version": "1.0.0",
  "description": "JR Intelligence control panel and B2B outreach pipeline.",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43149",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43149",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "dry-run": "ts-node --project tsconfig.cli.json src/main.ts --dry-run --preview",
    "send:csv": "ts-node --project tsconfig.cli.json src/main.ts",
    "preview": "ts-node --project tsconfig.cli.json src/preview/server.ts",
    "start:worker": "ts-node --project tsconfig.cli.json src/main.ts --worker",
    "test:dashboard": "ts-node --project tsconfig.cli.json src/main.ts --test-dashboard",
    "mock:dashboard": "ts-node --project tsconfig.cli.json src/mock/dashboardServer.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "juice": "^12.1.2",
    "lucide-react": "^1.40.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "openai": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
